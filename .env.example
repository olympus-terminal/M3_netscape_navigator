# AI Research Agent — environment configuration
# Copy this file to .env and edit to match your setup.

# === Codex agents ===
# Reuses saved authentication from `codex login`. Leave CODEX_MODEL empty to
# use the installed CLI's current default model.
# CODEX_BIN=/absolute/path/to/codex
# CODEX_MODEL=
CODEX_IGNORE_USER_CONFIG=true
# CODEX_JUDGE_TIMEOUT_SECONDS=900
# CODEX_WRITER_TIMEOUT_SECONDS=1800
# CODEX_JUDGE_BATCH_SIZE=12
# CODEX_JUDGE_BATCH_WAIT_SECONDS=5
# CODEX_JUDGE_WORKERS=1
# CODEX_MAX_JUDGE_ATTEMPTS=2
# CODEX_MAX_WRITER_ATTEMPTS=2
# CODEX_RETRY_DELAY_SECONDS=5

# === Optional local language model (recording proxy, no cloud fallback) ===
# LLM_BACKEND=openai_compatible
# LLM_BASE_URL=http://127.0.0.1:18101/v1
# LLM_MODEL=MiMo-V2.6-Flash-MOPD-MXFP4
# LLM_DEPLOYMENT=llama.cpp-MXFP4-two-GPU
# LLM_MAX_TOKENS=16384
# LLM_ENABLE_THINKING=false
# Keep one judge worker for a single model slot. Smaller batches shorten retries.
# CODEX_JUDGE_BATCH_SIZE=6
# CODEX_JUDGE_TIMEOUT_SECONDS=1800

# === TTS (optional — leave TTS_SCRIPT empty to skip audio synthesis) ===
# TTS_PYTHON=/path/to/tts-app/bin/python
# TTS_SCRIPT=/path/to/gpu-tts-toolkit/media_to_tts.py
TTS_VOICE=p246
TTS_FORMAT=mp3

# Optional Qwen3 narration on a provisioned Spark (voice assets stay private).
# Keep local_coqui until explicitly selecting the upgraded narration route.
TTS_BACKEND=local_coqui
# SPARK_TTS_HOST=tts-node
# SPARK_TTS_ROOT=/absolute/remote/path/to/versioned/tts/bundle
# SPARK_TTS_PYTHON=/absolute/remote/path/to/qwen3-tts/bin/python
# SPARK_TTS_VOICE=zv
# TTS_BACKEND=spark_qwen3

# === yt-dlp (optional — auto-detected if on PATH) ===
# YTDLP_BIN=/usr/bin/yt-dlp

# === Output directory (defaults to repo root) ===
# AGENT_DATA_DIR=/path/to/output

# === Digest length in hours ===
# TARGET_AUDIO_HOURS=3.0
# MAX_NARRATION_WORDS_PER_ITEM=500

# === Daily source volume ===
# Papers are judged in Codex batches; lower this to reduce daily quota use.
# MAX_PAGES_PER_SOURCE_PER_RUN=20
